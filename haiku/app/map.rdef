/*
 * retifs Map for Haiku: the app's resources (signature, one instance, version).
 */

resource app_signature "application/x-vnd.retifs-map";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 0,
	minor  = 1,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "retifs Map",
	long_info = "retifs Map: every record with a place, on maps from libraries in retifs"
};
