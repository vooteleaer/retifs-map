{
  "version": 8,
  "name": "retifs light",
  "metadata": { "retifs:note": "A plain style for OpenMapTiles-schema vector tiles (tilemaker's openmaptiles config). Tile URLs are relative to the map library: the app makes them absolute." },
  "sources": {
    "openmaptiles": { "type": "vector", "tiles": ["/tiles/{z}/{x}/{y}.pbf"], "minzoom": 0, "maxzoom": 14 }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f2efe9" } },

    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"], "paint": { "fill-color": "#cfe3c3" } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "farmland"]]], "paint": { "fill-color": "#e6eecf" } },
    { "id": "landcover-wetland", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wetland"], "paint": { "fill-color": "#dbe8e0" } },
    { "id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"], "paint": { "fill-color": "#f3e9c6" } },
    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "neighbourhood"]]], "paint": { "fill-color": "#e8e2da" } },
    { "id": "landuse-industrial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["industrial", "commercial", "retail", "railway"]]], "paint": { "fill-color": "#e6dfe6" } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "#d8ebc8" } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#aad3df" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 9,
      "paint": { "line-color": "#aad3df", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 14, 2.5] } },
    { "id": "aeroway", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway", "minzoom": 11, "paint": { "fill-color": "#dcd8e3" } },

    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "paint": { "fill-color": "#d9d0c9", "fill-outline-color": "#c8bdb4" } },

    { "id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["in", ["get", "class"], ["literal", ["path", "track"]]],
      "paint": { "line-color": "#b8a58c", "line-width": 1, "line-dasharray": [2, 1.5] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service"]]],
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 14, 4] } },
    { "id": "road-tertiary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["tertiary", "secondary"]]],
      "paint": { "line-color": "#fbfbe0", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 14, 5] } },
    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["in", ["get", "class"], ["literal", ["primary", "trunk"]]],
      "paint": { "line-color": "#f9d58a", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 14, 6] } },
    { "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 5,
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": { "line-color": "#e892a2", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 14, 7] } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9,
      "filter": ["==", ["get", "class"], "rail"],
      "paint": { "line-color": "#9a9a9a", "line-width": 1.2 } },
    { "id": "ferry", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["==", ["get", "class"], "ferry"],
      "paint": { "line-color": "#6f9bb3", "line-width": 1, "line-dasharray": [3, 2] } },

    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": { "line-color": "#a08aa0", "line-width": 1.5 } },
    { "id": "boundary-county", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "minzoom": 7,
      "filter": ["in", ["get", "admin_level"], ["literal", [4, 6]]],
      "paint": { "line-color": "#c4b4c4", "line-width": 0.8, "line-dasharray": [3, 2] } },

    { "id": "road-name", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-size": 11 },
      "paint": { "text-color": "#555555", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "water-name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
      "layout": { "text-field": ["get", "name"], "text-size": 12 },
      "paint": { "text-color": "#4a7a92", "text-halo-color": "#ffffff", "text-halo-width": 1 } },
    { "id": "housenumber", "type": "symbol", "source": "openmaptiles", "source-layer": "housenumber", "minzoom": 16,
      "layout": { "text-field": ["get", "housenumber"], "text-size": 10 },
      "paint": { "text-color": "#8a7f76" } },
    { "id": "place-village", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["village", "hamlet", "suburb", "neighbourhood", "isolated_dwelling"]]],
      "layout": { "text-field": ["get", "name"], "text-size": 12 },
      "paint": { "text-color": "#333333", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "place-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 6,
      "filter": ["in", ["get", "class"], ["literal", ["town", "city"]]],
      "layout": { "text-field": ["get", "name"], "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 12, 18] },
      "paint": { "text-color": "#222222", "text-halo-color": "#ffffff", "text-halo-width": 2 } }
  ]
}
